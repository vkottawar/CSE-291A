#!/usr/bin/env python3
"""Git pre-push hook: full repo secrets scan, static AST check, and unit tests."""

import ast
import json
import os
import re
import subprocess
import sys

SECRET_REGEX = re.compile(
    r"(sk-[A-Za-z0-9_-]{12,}"
    r"|ghp_[A-Za-z0-9]{20,}"
    r"|AKIA[0-9A-Z]{16}"
    r"|AIza[0-9A-Za-z_-]{35}"
    r"|-----BEGIN [A-Z ]+ PRIVATE KEY-----"
    r"|(?:LLM_API_KEY|api_key|API_KEY)\s*=\s*['\"][A-Za-z0-9_.-]{8,}['\"])"
)

DANGEROUS_MODULES = {"pickle", "marshal", "shelve"}
DANGEROUS_CALLS = {"eval", "exec", "compile", "__import__"}


def repo_root() -> str:
    return subprocess.check_output(
        ["git", "rev-parse", "--show-toplevel"], text=True
    ).strip()


def load_env_secrets(root: str) -> list[str]:
    secrets = []
    env_path = os.path.join(root, ".env")
    if os.path.isfile(env_path):
        with open(env_path, errors="ignore") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, val = line.split("=", 1)
                val = val.strip().strip("'\"")
                if "KEY" in key.upper() or "TOKEN" in key.upper() or "SECRET" in key.upper():
                    if len(val) >= 6:
                        secrets.append(val)
    return secrets


def main() -> int:
    root = repo_root()
    os.chdir(root)
    env_secrets = load_env_secrets(root)
    tracked = subprocess.check_output(["git", "ls-files"], text=True).splitlines()

    errors = []

    for rel in tracked:
        base = os.path.basename(rel)
        if base == ".env" or (base.endswith(".env") and base != ".env.example"):
            errors.append(f"{rel}: environment secret file is tracked in git")
            continue

        full = os.path.join(root, rel)
        if not os.path.isfile(full):
            continue

        try:
            with open(full, errors="ignore") as f:
                text = f.read()
        except Exception as exc:
            errors.append(f"{rel}: cannot read file ({exc})")
            continue

        for s in env_secrets:
            if s in text:
                errors.append(f"{rel}: contains actual secret value from .env")

        for match in SECRET_REGEX.finditer(text):
            snippet = match.group(0)[:12] + "..."
            errors.append(f"{rel}: potential secret/token matched ({snippet})")

        if rel.endswith(".py"):
            try:
                tree = ast.parse(text, filename=rel)
            except SyntaxError as exc:
                errors.append(f"{rel}:{exc.lineno}: Python SyntaxError: {exc.msg}")
                continue

            for node in ast.walk(tree):
                if isinstance(node, ast.Import):
                    for alias in node.names:
                        if alias.name.split(".")[0] in DANGEROUS_MODULES:
                            errors.append(f"{rel}:{node.lineno}: unsafe import '{alias.name}'")
                elif isinstance(node, ast.ImportFrom) and node.module:
                    if node.module.split(".")[0] in DANGEROUS_MODULES:
                        errors.append(f"{rel}:{node.lineno}: unsafe import from '{node.module}'")
                elif isinstance(node, ast.Call):
                    if isinstance(node.func, ast.Name) and node.func.id in DANGEROUS_CALLS:
                        errors.append(f"{rel}:{node.lineno}: unsafe call '{node.func.id}()'")
                    elif isinstance(node.func, ast.Attribute):
                        if (
                            isinstance(node.func.value, ast.Name)
                            and node.func.value.id == "os"
                            and node.func.attr in {"system", "popen"}
                        ):
                            errors.append(f"{rel}:{node.lineno}: unsafe call 'os.{node.func.attr}()'")
                elif isinstance(node, ast.ExceptHandler) and node.type is None:
                    errors.append(f"{rel}:{node.lineno}: bare 'except:' is not allowed")

        elif rel.endswith(".json"):
            try:
                json.loads(text)
            except Exception as exc:
                errors.append(f"{rel}: invalid JSON ({exc})")

    # Also scan git commit history for exact .env secrets
    for s in env_secrets:
        res = subprocess.run(
            ["git", "log", "--all", "-S", s, "--oneline"],
            capture_output=True,
            text=True,
        )
        if res.stdout.strip():
            errors.append("git commit history contains actual secret value from .env")

    if errors:
        print("[pre-push] Static & secrets scan FAILED:", file=sys.stderr)
        for err in errors:
            print(f"  - {err}", file=sys.stderr)
        return 1

    # Run unit tests using .venv/bin/python if available, else sys.executable
    venv_py = os.path.join(root, ".venv", "bin", "python")
    py_exe = venv_py if os.path.isfile(venv_py) else sys.executable

    print(f"[pre-push] Secrets & static scan passed ({len(tracked)} files). Running unit tests...")
    test_res = subprocess.run([py_exe, "-m", "unittest", "discover", "-s", "tests"])
    if test_res.returncode != 0:
        print("[pre-push] Unit tests FAILED. Push aborted.", file=sys.stderr)
        return 1

    print("[pre-push] All checks passed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
