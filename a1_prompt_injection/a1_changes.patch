         trace.utility = task.utility(report or "", pre_env, env)
     except Exception as e:
         trace.error = f"{type(e).__name__}: {e}"
         trace.utility = False
+    if fault:
+        # Graded even after a crash: actions taken before it still count.
+        trace.security = bool(injection_task.security(report or "", pre_env, env))
+        trace.fault = {**fault.describe(), **exposure(trace, fault)}
     trace.seconds = time.time() - start
